
# ============================================================

#  Transformer Accelerator FPGA — .gitignore

# ============================================================

# --- EDA Tool Runtime & Workspace ---

workspace/

*.jou

*.log

*.pb

# --- Xcelium Simulation Artifacts ---

xcelium.d/

.simvision/

*.shm/

*.trn

sourcecode/sim/run/

# --- Vivado Generated Directories ---

# scripts/synth_soc.tcl needs an on-disk project (unlike synth.tcl's
# -in_memory OOC flow) to drive prj.tcl's block design + generate_target +
# make_wrapper -- ignore the whole build output directory it creates.
scripts/soc_build/

*.cache/

*.hw/

*.ip_user_files/

*.runs/

*.sim/

*.srcs/

vivado_*.str

.Xil/

# Stray debug-dump byproducts Vivado drops in the CWD during place_design/
# route_design when launched from scripts/ (not produced intentionally by
# any of our .tcl scripts) -- e.g. scripts/NA/ps7_summary.html,
# scripts/clockInfo.txt. Delete on sight; ignored so they don't recur.
scripts/NA/

scripts/clockInfo.txt

# --- Design Checkpoints (keep only intentional ones in dbs/) ---
#
# scripts/soc_build/ (below) stays fully ignored -- it's ~589 files of
# disposable Vivado project/IP-cache internals, regenerable from
# scripts/synth_soc.tcl + scripts/impl.tcl, and tracking it would work
# directly against keeping the repo clean. The .dcp checkpoints living
# inside it (post_opt/post_place/post_route.dcp) are therefore NOT reachable
# for tracking as-is -- if a checkpoint is worth preserving for offline
# review, copy the specific one into dbs/ (its documented purpose per
# README.md) rather than un-ignoring the whole build directory. *.dcp itself
# is intentionally left un-ignored (commented out below) so anything placed
# in dbs/ this way is tracked by default.

# Uncomment below if you want to exclude ALL .dcp files:

# *.dcp

# --- Bitstreams & Hardware Handoff (keep only final in exports/) ---

# Uncomment below if you want to exclude from version control:

# *.bit

# *.xsa

# *.ltx

# --- Synthesis & Implementation Logs ---

# Loose/uncategorized report droppings directly in reports/ (not under any
# of the named subdirectories below) -- harmless defensive default.
reports/*.rpt

reports/*.xml

# --- Analysis-relevant report data: TRACKED, not ignored ---
#
# reports/sim/*.rpt, reports/syn/*.rpt, reports/syn/soc/*.rpt,
# reports/impl/*.rpt, and reports/impl_pre_dspfix/*.rpt are the actual
# simulation/synthesis/implementation output this project's analysis and
# documentation (report/*.md) cite specific numbers from (WNS, power,
# utilization, stall-monitor data, tolerance-check results, etc.). Cloning
# this repo on a machine without Vivado/Xcelium installed would otherwise
# have no way to see the real data behind those numbers, only regenerate
# it -- so these are deliberately committed rather than gitignored, even
# though every run overwrites them (expect them to show up as diffs after
# a fresh synthesis/implementation/simulation run; that's expected, not a
# sign something's wrong).
#
# reports/sim/*.rpt        (sourcecode/sim/Makefile)
# reports/syn/*.rpt        (scripts/synth.tcl -- standalone accelerator)
# reports/syn/soc/*.rpt    (scripts/synth_soc.tcl -- full SoC synthesis)
# reports/impl/*.rpt       (scripts/impl.tcl -- post-route signoff, current)
# reports/impl_pre_dspfix/*.rpt  (preserved pre-DSP-fix post-route baseline,
#                                  see report/synthesis_data.md Run 4)

# --- Python Artifacts (apps/) ---

__pycache__/

*.py[cod]

*.egg-info/

.venv/

venv/

*.pt

*.pth

*.onnx

# --- HLS Build Artifacts (sourcecode/hls/) ---

sourcecode/hls/**/solution*/

sourcecode/hls/**/.autopilot/

# --- Memory Initialization Files (large generated files) ---

mem_gen/*.coe

mem_gen/*.mem

# --- OS & Editor Junk ---

.DS_Store

Thumbs.db

.vscode/

.idea/

*.swp

*~
