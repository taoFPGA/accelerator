
# ============================================================

#  Transformer Accelerator FPGA — .gitignore

# ============================================================

# --- EDA Tool Runtime & Workspace ---

workspace/

*.jou

*.log

*.pb

# --- Vivado Generated Directories ---

*.cache/

*.hw/

*.ip_user_files/

*.runs/

*.sim/

*.srcs/

vivado_*.str

.Xil/

# --- Design Checkpoints (keep only intentional ones in dbs/) ---

# Uncomment below if you want to exclude ALL .dcp files:

# *.dcp

# --- Bitstreams & Hardware Handoff (keep only final in exports/) ---

# Uncomment below if you want to exclude from version control:

# *.bit

# *.xsa

# *.ltx

# --- Synthesis & Implementation Logs ---

reports/*.rpt

reports/*.xml

# --- Python Artifacts (apps/) ---

__pycache__/

*.py[cod]

*.egg-info/

.venv/

venv/

*.pt

*.pth

*.onnx

# --- HLS Build Artifacts (sourcecode/hls/) ---

sourcecode/hls/**/solution*/

sourcecode/hls/**/.autopilot/

# --- Memory Initialization Files (large generated files) ---

mem_gen/*.coe

mem_gen/*.mem

# --- OS & Editor Junk ---

.DS_Store

Thumbs.db

.vscode/

.idea/

*.swp

*~
